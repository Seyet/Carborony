# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only (Project Settings > API Keys). Prefer the current sb_secret key;
# the legacy service_role key is also supported. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=your-project-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Meta Instagram API with Instagram Login (server only)
META_INSTAGRAM_APP_ID=your-instagram-app-id
META_INSTAGRAM_APP_SECRET=your-instagram-app-secret
META_INSTAGRAM_REDIRECT_URI=https://carborony.vercel.app/api/integrations/instagram/callback
META_INSTAGRAM_GRAPH_VERSION=v26.0
# Generate once with: openssl rand -base64 32
INSTAGRAM_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Paystack payout setup (server only). Start with a test secret key.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_key
# Carborony's share of each payment, from 0 to 100 (up to 2 decimals).
PAYSTACK_PLATFORM_COMMISSION_PERCENT=0

# Canonical checkout return origin. HTTPS required in live mode.
PAYMENTS_APP_URL=http://localhost:3000
